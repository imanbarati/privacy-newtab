{
  "manifest_version": 3,
  "name": "Privacy New Tab",
  "version": "1.0.1",
  "description": "Clean private new tab: clock, search, top sites & quick links. No AI ads, no tracking, no telemetry.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Privacy New Tab settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "homepage_url": "https://github.com/imanbarati/privacy-newtab",
  "offline_enabled": true
}
